<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath, configuração de artefato "instalador": o GitHub envia um zip só com o instalador.exe. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="instalador.exe" product-name="SIAPP">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
